rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the project owner
    function isOwner(projectData) {
      return request.auth.token.email == projectData.ownerEmail;
    }

    // Helper function to load signed-in user role from users collection
    function userRole() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : 'user';
    }

    // Helper function for premium-feature access
    function isPaidOrAdmin() {
      return userRole() in ['paid-user', 'admin'];
    }

    // Helper function to check if project is public
    function isPublicProject(projectData) {
      return projectData.licenceKey == 'public';
    }

    // Projects collection rules
    match /projects/{projectId} {
      // Allow read for any authenticated user
      allow read: if isAuthenticated();

      // Allow create if:
      // - User is authenticated AND
      // - The ownerEmail in the new document matches the authenticated user's email
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerEmail == request.auth.token.email;

      // Allow update/delete if:
      // - User is authenticated AND
      // - User is the owner
      allow update, delete: if isAuthenticated() && isOwner(resource.data);

      // Project objects subcollection
      match /objects/{objectId} {
        // Allow read if authenticated and parent project exists and is readable
        allow read: if isAuthenticated() &&
                       exists(/databases/$(database)/documents/projects/$(projectId)) &&
                       (isPublicProject(get(/databases/$(database)/documents/projects/$(projectId)).data) ||
                        isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data));

        // Allow create if user is authenticated (parent project ownership will be verified separately)
        allow create: if isAuthenticated();

        // Allow update/delete if user owns the parent project
        allow update, delete: if isAuthenticated() &&
                                 exists(/databases/$(database)/documents/projects/$(projectId)) &&
                                 isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Users can create their own profile only with base role.
      allow create: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       request.resource.data.role == 'user';

      // Users can update their profile but cannot change their role themselves.
      allow update: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       request.resource.data.role == resource.data.role;

      allow delete: if false;
    }
  }
}
